<%#
  検索欄（本体 v4.2.1 の shared/_search.html.erb を写して、詳しい条件を折りたためるようにしたもの）。
  トップとリポジトリの画面では、最初はキーワードと検索ボタンだけを出し、
  絞り込み・検索フィールド・年・行の追加は「詳しい条件」ボタンで開く。
  条件が 1 つでも入っているとき（検索し直したとき）は、最初から開いておく。
  検索結果の「検索を絞り込む」の中では、すでに畳まれているので折りたたまない。
  本体との違いは、ja_collapsible・ja_open の計算と <style>、form の class、キーワード欄の class、#submit_div のボタンの 5 か所。
  本体を上げたときは、この 5 か所以外を本体の新しい版に合わせる。
%>
<%
  show_header = true if show_header.nil?
  header_size = '2' if header_size.nil?
%>
<div class="search pt-3" role="search">
  <a id="search" tabindex="-1"></a>
  <% if show_header %>
    <h<%= header_size %>><%=  t('actions.search_header') %></h<%= header_size %>>
  <% end %>
  <% @search = Search.new unless defined?(@search) %>
  <%
    ja_collapsible = controller_name == 'welcome' || (controller_name == 'repositories' && action_name == 'show')
    ja_open = @search.q.length > 1 ||
              [@search[:field], @search[:from_year], @search[:to_year]].any? { |v| Array(v).any?(&:present?) } ||
              @search[:limit].present? || params[:limit].present?
  %>
  <% if ja_collapsible %>
  <style>
    .jt-search--closed .search_row > .form-group:not(.jt-search__keyword),
    .jt-search--closed .search_row:not(#search_row_0) { display: none; }
    .jt-search--closed #search_row_0 > .jt-search__keyword { flex: 0 0 100%; max-width: 100%; }
    .jt-search #submit_div > [class*="col-"] { flex: 0 0 100%; max-width: 100%; display: flex; flex-wrap: wrap; align-items: center; gap: .5rem 1rem; }
    .jt-search #submit_search { width: auto; min-width: 12rem; }
    .jt-search__toggle {
      padding: .25rem 0; border: 0; background: none; color: var(--c-accent-dark); font-size: .92rem; font-weight: 600; cursor: pointer;
    }
    .jt-search__toggle:hover { text-decoration: underline; }
    .jt-search__toggle:focus-visible { outline: none; box-shadow: var(--c-focus-ring); border-radius: 4px; }
    .jt-search__toggle::after { content: ""; display: inline-block; width: .45em; height: .45em; margin-left: .45em; border: solid currentColor; border-width: 0 2px 2px 0; transform: translateY(-.15em) rotate(45deg); transition: transform .15s; }
    .jt-search__toggle[aria-expanded="true"]::after { transform: translateY(.05em) rotate(-135deg); }
  </style>
  <% end %>
  <%= form_tag(app_prefix("#{search_url}"), method: 'get', :id => 'advanced_search',
               :class => ja_collapsible ? "jt-search#{' jt-search--closed' unless ja_open}" : nil) do %>
  <% (0...[1, @search.q.length].max).each do |i| %>
    <div class="row search_row align-items-end pt-1" id="search_row_<%= i %>">
      <div class="col-sm-6 col-md-4 col-xl-1 bool form-group search-operator-field">
        <%= label_tag("op#{i}", t('advanced_search.operator_label'), :class => 'font-weight-bold') %>
        <%= select_tag('op[]', options_for_select(Search.get_boolean_opts, @search[:op][i]), disabled: (i == 0), :id => "op#{i}",:class=> 'form-control' + (i == 0 ? ' d-none' : '') + ' options-for-select') %>
        <%= hidden_field_tag('op[]','', :id => 'op_') if i == 0 %>
      </div>
      <div class="col-xl-3 col-lg-6 form-group jt-search__keyword">
        <%= label_tag(:"q#{i}", t('navbar.search_placeholder'),:class => 'repeats font-weight-bold') %>
        <%= text_field_tag('q[]', @search[:q][i], :placeholder =>  t('navbar.search_placeholder'), :id => "q#{i}",
                          :class=> 'form-control repeats fill-column js-search-box') %>
      </div>
      <div class="col-xl-3 col-md-6 form-group norepeat">
        <%= label_tag(:limit, t('advanced_search.limit_label'),:class => 'font-weight-bold') %>
        <%
          # Determine the default limit value
          default_limit = if @search[:limit].present?
                            @search[:limit]
                          elsif params.key?(:limit)
                            params[:limit]
                          else
                            SearchConfigHelper.default_search_scope == 'collections_only' ? 'resource' : ''
                          end
        %>
        <%= select_tag(:limit, options_for_select(limit_options, default_limit), :class=> 'form-control fill-column') %>
      </div>
      <div class="col-xl-2 col-lg-4 col-md-6 form-group">
        <%= label_tag(:"field#{i}", t('search-field'),:class => 'repeats font-weight-bold') %>
        <%= select_tag('field[]', options_for_select(field_options, @search[:field][i]), :id=> "field#{i}", :class=> 'form-control repeats') %>
      </div>
      <div class="col-xl-1 col-lg-3 col-sm-5 form-group">
        <%= label_tag(:"from_year#{i}", "#{t('search_results.filter.from_year')}", :class => 'repeats font-weight-bold') %>
        <%= text_field_tag('from_year[]', @search[:from_year][i], :size => 4,:maxlength => 4, :id=>"from_year#{i}",
                          :placeholder => t('search_results.filter.from'),:class=>'form-control repeats') %>
      </div>
      <div class="col-xl-1 col-lg-3 col-sm-5 form-group">
        <%= label_tag(:"to_year#{i}", "#{t('search_results.filter.to_year')}", :class=> 'repeats font-weight-bold') %>
        <%= text_field_tag('to_year[]', @search[:to_year][i], :size => 4, :maxlength => 4, :id => "to_year#{i}",
                          :class=> 'form-control repeats', :placeholder => t('search_results.filter.to')) %>
      </div>
      <div class="col-sm-2 form-group text-left align-self-end">
          <span class="mb-2 d-inline-block repeats plusminus_label font-weight-bold"><%= t('advanced_search.add_row') %></span><br />
          <button type="button"
                  class="btn btn-light border plusminus-btn"
                  id="plusminus<%= i %>"
                  data-action="add"
                  title="<%= t('advanced_search.add_row') %>"
                  aria-label="<%= t('advanced_search.add_row') %>">
            <i class="fa fa-plus" aria-hidden="true"></i>
          </button>
      </div>
    </div>
  <% end %>
    <div class="row" id="submit_div">
      <div class="col-sm-3">
        <%= submit_tag(t('search-button.label'), :class=>'btn btn-primary', :id => 'submit_search') %>
        <% if ja_collapsible %>
          <button type="button" class="jt-search__toggle" aria-controls="advanced_search" aria-expanded="<%= ja_open %>"
                  onclick="var f=this.form,c=f.classList.toggle('jt-search--closed');this.setAttribute('aria-expanded',!c);if(!c){var s=f.querySelector('#search_row_0 .norepeat select');if(s)s.focus();}"><%= t('ja_theme.search.more') %></button>
        <% end %>
      </div>
    </div>
  <% end %>
</div>
<script type="text/javascript" >initialize_search();</script>
